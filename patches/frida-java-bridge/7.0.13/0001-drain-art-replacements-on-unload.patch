+// Call with an attached native thread. Suspend ART and lock its thread list
+// while inspecting frames, including calls waiting to enter a NativeCallback.
+export function hasActiveReplacementFrames (replacements, env) {
+  const api = getApi();
+  if (replacements.length === 0) {
+    return false;
+  }
+  const targets = new Set(replacements.map(r => r._m.replacementMethodId.toString()));
+  const forEach = new NativeFunction(api.module.getExportByName('_ZN3art10ThreadList7ForEachEPFvPNS_6ThreadEPvES3_'),
+    'void', ['pointer', 'pointer', 'pointer'], { scheduling: 'exclusive' });
+  // Use the same visitor storage size as ArtStackVisitor. Keep the JS lock
+  // throughout the native stack walk while ART's locks are held.
+  const options = { scheduling: 'exclusive' };
+  const initVisitor = new NativeFunction(api['art::StackVisitor::StackVisitor'],
+    'void', ['pointer', 'pointer', 'pointer', 'uint', 'size_t', 'bool'], options);
+  const walkStack = new NativeFunction(api['art::StackVisitor::WalkStack'],
+    'void', ['pointer', 'bool'], options);
+  const getMethod = new NativeFunction(api['art::StackVisitor::GetMethod'],
+    'pointer', ['pointer'], options);
+  const visitor = Memory.alloc(512 + 3 * pointerSize);
+  const vtable = visitor.add(512);
+  let active = false;
+  const visitFrame = new NativeCallback(handle => {
+    if (targets.has(getMethod(handle).toString())) {
+      active = true;
+      return false;
+    }
+    return true;
+  }, 'bool', ['pointer']);
+  vtable.add(2 * pointerSize).writePointer(visitFrame);
+  const visit = new NativeCallback(thread => {
+    initVisitor(visitor, thread, NULL, 1, 0, true);
+    visitor.writePointer(vtable);
+    walkStack(visitor, false);
+  }, 'void', ['pointer', 'pointer']);
+  const self = getArtThreadFromEnv(env);
+  const threadListLock = api.module.getExportByName('_ZN3art5Locks17thread_list_lock_E').readPointer();
+  const lock = new NativeFunction(api.module.getExportByName('_ZN3art5Mutex13ExclusiveLockEPNS_6ThreadE'),
+    'void', ['pointer', 'pointer'], { scheduling: 'exclusive' });
+  const unlock = new NativeFunction(api.module.getExportByName('_ZN3art5Mutex15ExclusiveUnlockEPNS_6ThreadE'),
+    'void', ['pointer', 'pointer'], { scheduling: 'exclusive' });
+  withAllArtThreadsSuspended(() => {
+    lock(threadListLock, self);
+    try {
+      forEach(api.artThreadList, visit, NULL);
+    } finally {
+      unlock(threadListLock, self);
+    }
+  });
+  return active;
+}
