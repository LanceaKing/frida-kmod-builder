--- a/src/barebone/agent/linux/frida-kmod.c
+++ b/src/barebone/agent/linux/frida-kmod.c
@@ -2302,9 +2302,20 @@
   void * mapping;
   struct frida_writable_alias * alias;
 
+  if (n_pages == 0 || (first_page & ~PAGE_MASK) != 0)
+    return NULL;
   pages = kmalloc_array (n_pages, sizeof (struct page *), GFP_KERNEL);
+  if (pages == NULL)
+    return NULL;
   for (i = 0; i != n_pages; i++)
+  {
     pages[i] = frida_page_for_virtual (first_page + ((unsigned long) i * PAGE_SIZE));
+    if (pages[i] == NULL)
+    {
+      kfree (pages);
+      return NULL;
+    }
+  }
 
   mapping = vmap (pages, n_pages, VM_MAP, PAGE_KERNEL);
 
@@ -2314,6 +2325,11 @@
     return NULL;
 
   alias = kmalloc (sizeof (struct frida_writable_alias), GFP_KERNEL);
+  if (alias == NULL)
+  {
+    vunmap (mapping);
+    return NULL;
+  }
   alias->mapping = mapping;
   alias->first_page = first_page;
   alias->n_pages = n_pages;
@@ -2353,6 +2369,13 @@
 static struct page *
 frida_page_for_virtual (unsigned long address)
 {
+#ifdef CONFIG_ARM64
+  /* On Android 5.10, the KASLR image falls inside is_vmalloc_addr's broad
+   * range. vmalloc_to_page cannot walk the image's block mappings. Classify
+   * the known image first and use the architecture's image translation. */
+  if (address >= frida_kernel_base && address - frida_kernel_base < frida_kernel_size)
+    return pfn_to_page (__phys_to_pfn (__pa_symbol (address)));
+#endif
   if (frida_is_vmalloc_or_module_addr ((void *) address))
     return vmalloc_to_page ((void *) address);
 
